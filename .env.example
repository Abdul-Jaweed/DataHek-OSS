# DataHek OSS — environment template (Docker compose reads this)
# LLM endpoint (any OpenAI-compatible service) — can also be set at runtime
# from the web UI → Settings → LLM provider.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Persistent metadata (optional) — when set, connections/conversations/
# prompts/evaluations live in PostgreSQL and LLM settings survive restarts
# via Redis. Leave empty for the SQLite/in-memory defaults.
# (docker-compose sets these automatically — see services postgres/redis.)
DATAHEK_METADATA_URL=
DATAHEK_METADATA_REDIS_URL=
# Optional: encrypt connection settings at rest in PostgreSQL (any string).
DATAHEK_ENCRYPTION_KEY=

# Infisical secrets (optional) — when set, secrets are fetched from Infisical:
#   · connection credentials via secret://infisical/<folder>/<key>
#   · auth users at /auth (datahek_users)
#   · LLM settings at /llm
INFISICAL_HOST=
INFISICAL_CLIENT_ID=
INFISICAL_CLIENT_SECRET=
INFISICAL_PROJECT_ID=

# Local authentication (optional)
DATAHEK_AUTH_MODE=none
DATAHEK_AUTH_LOCAL_USERS={"datahek":"datahek"}